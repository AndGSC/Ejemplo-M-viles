# Copiar este archivo como .env (cp .env.example .env) y ajustar los valores.
# El archivo .env NUNCA se sube al repositorio.

# --- Base de datos PostgreSQL ---
POSTGRES_DB=edus_db
POSTGRES_USER=edus_user
POSTGRES_PASSWORD=edus_pass_change_me
# Puerto del host para conectarse a la BD desde fuera de Docker (DBeaver, pgAdmin, psql)
DB_HOST_PORT=5433

# --- API ---
PORT=3000

# --- JWT ---
# Secreto para firmar los tokens: mínimo 32 caracteres aleatorios.
# Generar uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_chars
# Duración del token (formatos válidos: 15m, 2h, 7d)
JWT_EXPIRES_IN=2h
